# Postgres credentials used both by the postgres service and to build
# DATABASE_URL for the other services in docker-compose.yml.
POSTGRES_USER=vrt
POSTGRES_PASSWORD=vrt
POSTGRES_DB=vrt

# For local (non-Docker) development against `docker compose up postgres redis`,
# override these to point at localhost instead of the service names below.
DATABASE_URL=postgres://vrt:vrt@postgres:5432/vrt
REDIS_URL=redis://redis:6379

STORAGE_DRIVER=local
# In containers this is /data/shots, bind-mounted from ./.data/shots on the
# host (see docker-compose.yml) - so a locally-run web/worker can read the
# same shots by pointing STORAGE_LOCAL_PATH at that host path directly.
STORAGE_LOCAL_PATH=/data/shots
STORAGE_URL_PREFIX=/api/shots

# Auth mode: "none" (single-user, no login) or "clerk" (multi-user).
AUTH_MODE=none
# Required only when AUTH_MODE=clerk. Note: the publishable key is NOT
# NEXT_PUBLIC_* on purpose - it is passed to the client at request time so
# one build works in both modes.
#CLERK_SECRET_KEY=sk_test_...
#CLERK_PUBLISHABLE_KEY=pk_test_...
# Required by @clerk/nextjs because middleware.ts passes secretKey as an
# explicit ("dynamic keys") option - see docs linked in the middleware error.
# A random 32-byte hex string, e.g. `openssl rand -hex 32`.
#CLERK_ENCRYPTION_KEY=...
# Only for `npm run e2e` (apps/web/.env): password of the vrt+clerk_test
# admin user on your Clerk dev instance - see docs/notes/auth.md.
#E2E_ADMIN_PASSWORD=...

# E-mail notifications. Set SMTP_URL *and* MAIL_FROM to turn them on - with
# neither the UI shows the feature as unavailable, with only one of the two
# the app refuses to start a send and names the missing one. SMTP_URL is
# nodemailer's URL form: smtp://user:pass@host:587 or
# smtps://user:pass@host:465.
#SMTP_URL=smtp://user:pass@smtp.example.com:587
#MAIL_FROM=VRT <vrt@example.com>
# Public base URL of the web app, used for the links inside the e-mails.
# Not part of the on/off switch: docker-compose and scripts/dev.mjs default
# it to http://localhost:3000, so set it only for a real deployment.
#APP_URL=http://localhost:3000
